# Local Docker Compose configuration. Replace the application secret before use.
SECRET_KEY=replace-with-a-random-32-plus-character-secret
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
POSTGRES_PASSWORD=tera-local-database-password
DATABASE_URL=postgresql+psycopg://tera:tera-local-database-password@postgres:5432/tera
REDIS_URL=redis://redis:6379/0

# Empty endpoint uses persistent local files in the recordings_data volume.
# Optional S3/MinIO setup is described in docs/SECOND_LAPTOP_SETUP.md.
S3_ENDPOINT=
S3_ACCESS_KEY=tera-local
S3_SECRET_KEY=tera-local-storage-secret
S3_BUCKET=tera-evidence
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=TERA <no-reply@tera.local>

# Optional external providers. Never put real credentials in Git.
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_WEBHOOK_SECRET=
SPEECH_PROVIDER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The emergency companion sends LLM requests only through OpenRouter.
# Keep real credentials in a local .env or deployment secret, never in Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Legacy aliases retained only for existing installations.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4.1-mini

# Shared deployments require production mode, HTTPS, secure cookies,
# unique credentials, persistent PostgreSQL and configured mail/storage.
